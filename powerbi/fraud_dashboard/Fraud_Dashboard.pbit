// ============================================================================
// FinCo AI — Fraud Dashboard
// File: Fraud_Dashboard.pbit
// Power Query / M Data Model Layer
// ============================================================================
//
// PURPOSE
// -------
// Enterprise Fraud Dashboard data preparation layer.
//
// Architecture:
//
//   Connection Parameters
//          ↓
//   Transactions / Fraud Alerts
//          ↓
//   Common Transformations
//          ↓
//   Fraud Transformations
//          ↓
//   Fraud Dashboard
//          ↓
//   Fraud KPIs / Alerts / Investigation
//          ↓
//   Supervisor Agent
//
// EXPECTED UPSTREAM QUERIES
// -------------------------
//   connection_parameters
//   common_transformations
//   Transactions
//   FraudAlerts
//
// IMPORTANT
// ---------
// Production ML fraud scoring should remain in:
//
//   backend/app/fraud/
//       preprocessing.py
//       feature_engineering.py
//       supervised_model.py
//       anomaly_model.py
//       scoring.py
//       thresholds.py
//       explainability.py
//
// Power BI is the analytical / visualization layer.
// ============================================================================


let

    // =========================================================================
    // 1. CONNECTION PARAMETERS
    // =========================================================================

    Parameters =
        try connection_parameters
        otherwise
            [
                Environment = "DEV",
                DefaultCurrency = "INR",
                DefaultStartDate = #date(2020, 1, 1),
                DefaultEndDate = #date(2035, 12, 31),
                TransactionsTable = "Transactions",
                FraudAlertsTable = "FraudAlerts"
            ],


    // =========================================================================
    // 2. SAFE HELPER FUNCTIONS
    // =========================================================================

    SafeText = (value as any) as nullable text =>
        let
            Result =
                try
                    if value = null
                    then null
                    else Text.Trim(Text.From(value))
                otherwise null
        in
            Result,


    SafeNumber = (value as any) as nullable number =>
        let
            Result =
                try Number.From(value)
                otherwise null
        in
            Result,


    SafeDate = (value as any) as nullable date =>
        let
            Result =
                try Date.From(value)
                otherwise null
        in
            Result,


    SafeDateTime = (value as any) as nullable datetime =>
        let
            Result =
                try DateTime.From(value)
                otherwise null
        in
            Result,


    SafeDivide = (numerator as any, denominator as any) as nullable number =>
        let
            N = SafeNumber(numerator),
            D = SafeNumber(denominator),
            Result =
                if N = null or D = null or D = 0
                then null
                else N / D
        in
            Result,


    Clamp = (value as any, minValue as number, maxValue as number) as number =>
        let
            V = SafeNumber(value),
            Result =
                if V = null
                then 0
                else if V < minValue
                then minValue
                else if V > maxValue
                then maxValue
                else V
        in
            Result,


    HasColumn = (table as table, columnName as text) as logical =>
        List.Contains(Table.ColumnNames(table), columnName),


    GetColumn = (
        table as table,
        columnName as text,
        optional defaultValue as any
    ) as list =>
        if HasColumn(table, columnName)
        then Table.Column(table, columnName)
        else List.Repeat({defaultValue}, Table.RowCount(table)),


    // =========================================================================
    // 3. SOURCE — TRANSACTIONS
    // =========================================================================

    TransactionSource =
        try Transactions
        otherwise #table(
            {
                "TransactionId",
                "CompanyId",
                "CompanyName",
                "TransactionDate",
                "CustomerId",
                "SupplierId",
                "AccountId",
                "TransactionType",
                "TransactionCategory",
                "PaymentMethod",
                "Currency",
                "Amount",
                "Description",
                "Status"
            },
            {}
        ),


    TransactionColumns =
        Table.ColumnNames(TransactionSource),


    // =========================================================================
    // 4. STANDARDIZE TRANSACTION COLUMN NAMES
    // =========================================================================

    StandardizedColumns =
        Table.TransformColumnNames(
            TransactionSource,
            each Text.Trim(_)
        ),


    // =========================================================================
    // 5. ENSURE REQUIRED COLUMNS EXIST
    // =========================================================================

    RequiredColumns = {
        "TransactionId",
        "CompanyId",
        "CompanyName",
        "TransactionDate",
        "CustomerId",
        "SupplierId",
        "AccountId",
        "TransactionType",
        "TransactionCategory",
        "PaymentMethod",
        "Currency",
        "Amount",
        "Description",
        "Status"
    },


    EnsureColumns =
        List.Accumulate(
            RequiredColumns,
            StandardizedColumns,
            (state, columnName) =>
                if HasColumn(state, columnName)
                then state
                else Table.AddColumn(
                    state,
                    columnName,
                    each null
                )
        ),


    // =========================================================================
    // 6. TYPE NORMALIZATION
    // =========================================================================

    TypedTransactions =
        Table.TransformColumns(
            EnsureColumns,
            {
                {
                    "TransactionId",
                    each SafeText(_),
                    type text
                },
                {
                    "CompanyId",
                    each SafeText(_),
                    type text
                },
                {
                    "CompanyName",
                    each SafeText(_),
                    type text
                },
                {
                    "TransactionDate",
                    each SafeDate(_),
                    type date
                },
                {
                    "CustomerId",
                    each SafeText(_),
                    type text
                },
                {
                    "SupplierId",
                    each SafeText(_),
                    type text
                },
                {
                    "AccountId",
                    each SafeText(_),
                    type text
                },
                {
                    "TransactionType",
                    each SafeText(_),
                    type text
                },
                {
                    "TransactionCategory",
                    each SafeText(_),
                    type text
                },
                {
                    "PaymentMethod",
                    each SafeText(_),
                    type text
                },
                {
                    "Currency",
                    each SafeText(_),
                    type text
                },
                {
                    "Amount",
                    each SafeNumber(_),
                    type number
                },
                {
                    "Description",
                    each SafeText(_),
                    type text
                },
                {
                    "Status",
                    each SafeText(_),
                    type text
                }
            }
        ),


    // =========================================================================
    // 7. TEXT NORMALIZATION
    // =========================================================================

    CleanText =
        Table.TransformColumns(
            TypedTransactions,
            {
                {
                    "CompanyName",
                    each if _ = null then null else Text.Proper(_),
                    type text
                },
                {
                    "TransactionType",
                    each if _ = null then null else Text.Upper(_),
                    type text
                },
                {
                    "TransactionCategory",
                    each if _ = null then null else Text.Upper(_),
                    type text
                },
                {
                    "PaymentMethod",
                    each if _ = null then null else Text.Upper(_),
                    type text
                },
                {
                    "Currency",
                    each if _ = null then null else Text.Upper(_),
                    type text
                },
                {
                    "Status",
                    each if _ = null then null else Text.Upper(_),
                    type text
                }
            }
        ),


    // =========================================================================
    // 8. REMOVE INVALID TRANSACTION RECORDS
    // =========================================================================

    ValidTransactions =
        Table.SelectRows(
            CleanText,
            each
                [TransactionId] <> null
                and [TransactionDate] <> null
                and [Amount] <> null
        ),


    // =========================================================================
    // 9. DATE ATTRIBUTES
    // =========================================================================

    AddFraudYear =
        Table.AddColumn(
            ValidTransactions,
            "FraudYear",
            each Date.Year([TransactionDate]),
            Int64.Type
        ),


    AddFraudMonth =
        Table.AddColumn(
            AddFraudYear,
            "FraudMonth",
            each Date.Month([TransactionDate]),
            Int64.Type
        ),


    AddFraudMonthName =
        Table.AddColumn(
            AddFraudMonth,
            "FraudMonthName",
            each Date.MonthName([TransactionDate]),
            type text
        ),


    AddFraudQuarter =
        Table.AddColumn(
            AddFraudMonthName,
            "FraudQuarter",
            each "Q" & Text.From(Date.QuarterOfYear([TransactionDate])),
            type text
        ),


    AddFraudPeriodKey =
        Table.AddColumn(
            AddFraudQuarter,
            "FraudPeriodKey",
            each
                Date.Year([TransactionDate]) * 100
                + Date.Month([TransactionDate]),
            Int64.Type
        ),


    // =========================================================================
    // 10. TRANSACTION DIRECTION
    // =========================================================================

    AddTransactionDirection =
        Table.AddColumn(
            AddFraudPeriodKey,
            "TransactionDirection",
            each
                if List.Contains(
                    {
                        "PAYMENT",
                        "EXPENSE",
                        "WITHDRAWAL",
                        "REFUND",
                        "DEBIT"
                    },
                    [TransactionType]
                )
                then "OUTFLOW"
                else if List.Contains(
                    {
                        "RECEIPT",
                        "REVENUE",
                        "DEPOSIT",
                        "CREDIT",
                        "COLLECTION"
                    },
                    [TransactionType]
                )
                then "INFLOW"
                else "OTHER",
            type text
        ),


    // =========================================================================
    // 11. ABSOLUTE TRANSACTION VALUE
    // =========================================================================

    AddAbsoluteAmount =
        Table.AddColumn(
            AddTransactionDirection,
            "AbsoluteAmount",
            each Number.Abs([Amount]),
            type number
        ),


    // =========================================================================
    // 12. HIGH VALUE TRANSACTION FLAG
    // =========================================================================

    AddHighValueFlag =
        Table.AddColumn(
            AddAbsoluteAmount,
            "HighValueTransactionFlag",
            each
                if [AbsoluteAmount] >= 1000000
                then 1
                else if [AbsoluteAmount] >= 500000
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 13. VERY HIGH VALUE FLAG
    // =========================================================================

    AddVeryHighValueFlag =
        Table.AddColumn(
            AddHighValueFlag,
            "VeryHighValueTransactionFlag",
            each
                if [AbsoluteAmount] >= 5000000
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 14. ROUND AMOUNT
    // =========================================================================

    RoundedAmounts =
        Table.TransformColumns(
            AddVeryHighValueFlag,
            {
                {
                    "Amount",
                    each if _ = null then null else Number.Round(_, 2),
                    type number
                },
                {
                    "AbsoluteAmount",
                    each if _ = null then null else Number.Round(_, 2),
                    type number
                }
            }
        ),


    // =========================================================================
    // 15. TRANSACTION KEY
    // =========================================================================

    AddTransactionKey =
        Table.AddColumn(
            RoundedAmounts,
            "FraudTransactionKey",
            each
                Text.Combine(
                    {
                        if [CompanyId] = null then "" else [CompanyId],
                        if [TransactionId] = null then "" else [TransactionId]
                    },
                    "|"
                ),
            type text
        ),


    // =========================================================================
    // 16. DUPLICATE TRANSACTION COUNT
    // =========================================================================

    DuplicateGroups =
        Table.Group(
            AddTransactionKey,
            {
                "CompanyId",
                "TransactionDate",
                "Amount",
                "CustomerId",
                "SupplierId"
            },
            {
                {
                    "DuplicateTransactionCount",
                    each Table.RowCount(_),
                    Int64.Type
                }
            }
        ),


    JoinDuplicates =
        Table.NestedJoin(
            AddTransactionKey,
            {
                "CompanyId",
                "TransactionDate",
                "Amount",
                "CustomerId",
                "SupplierId"
            },
            DuplicateGroups,
            {
                "CompanyId",
                "TransactionDate",
                "Amount",
                "CustomerId",
                "SupplierId"
            },
            "DuplicateData",
            JoinKind.LeftOuter
        ),


    ExpandDuplicates =
        Table.ExpandTableColumn(
            JoinDuplicates,
            "DuplicateData",
            {
                "DuplicateTransactionCount"
            },
            {
                "DuplicateTransactionCount"
            }
        ),


    // =========================================================================
    // 17. DUPLICATE FLAG
    // =========================================================================

    AddDuplicateFlag =
        Table.AddColumn(
            ExpandDuplicates,
            "DuplicateTransactionFlag",
            each
                if [DuplicateTransactionCount] <> null
                    and [DuplicateTransactionCount] > 1
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 18. ROUND NUMBER PATTERN
    // =========================================================================

    AddRoundAmountFlag =
        Table.AddColumn(
            AddDuplicateFlag,
            "RoundAmountFlag",
            each
                if [AbsoluteAmount] <> null
                    and Number.Mod([AbsoluteAmount], 10000) = 0
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 19. WEEKEND TRANSACTION
    // =========================================================================

    AddWeekendFlag =
        Table.AddColumn(
            AddRoundAmountFlag,
            "WeekendTransactionFlag",
            each
                if Date.DayOfWeek(
                    [TransactionDate],
                    Day.Monday
                ) >= 5
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 20. MONTH-END TRANSACTION
    // =========================================================================

    AddMonthEndFlag =
        Table.AddColumn(
            AddWeekendFlag,
            "MonthEndTransactionFlag",
            each
                if Date.Day([TransactionDate])
                    >= Date.DaysInMonth([TransactionDate]) - 2
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 21. YEAR-END TRANSACTION
    // =========================================================================

    AddYearEndFlag =
        Table.AddColumn(
            AddMonthEndFlag,
            "YearEndTransactionFlag",
            each
                if Date.Month([TransactionDate]) = 12
                    and Date.Day([TransactionDate]) >= 29
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 22. SUSPICIOUS PAYMENT METHODS
    // =========================================================================

    AddPaymentMethodRiskFlag =
        Table.AddColumn(
            AddYearEndFlag,
            "PaymentMethodRiskFlag",
            each
                if List.Contains(
                    {
                        "CASH",
                        "UNKNOWN",
                        "OTHER",
                        "MANUAL"
                    },
                    [PaymentMethod]
                )
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 23. MISSING CUSTOMER / SUPPLIER IDENTIFIER
    // =========================================================================

    AddMissingPartyFlag =
        Table.AddColumn(
            AddPaymentMethodRiskFlag,
            "MissingPartyFlag",
            each
                if
                    [CustomerId] = null
                    and [SupplierId] = null
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 24. COMPOSITE RULE-BASED FRAUD SCORE
    // =========================================================================

    AddRuleScore =
        Table.AddColumn(
            AddMissingPartyFlag,
            "RuleBasedFraudScore",
            each
                Clamp(
                    [DuplicateTransactionFlag] * 25
                    + [VeryHighValueTransactionFlag] * 20
                    + [HighValueTransactionFlag] * 10
                    + [RoundAmountFlag] * 10
                    + [WeekendTransactionFlag] * 10
                    + [MonthEndTransactionFlag] * 10
                    + [YearEndTransactionFlag] * 5
                    + [PaymentMethodRiskFlag] * 5
                    + [MissingPartyFlag] * 5,
                    0,
                    100
                ),
            type number
        ),


    // =========================================================================
    // 25. RULE-BASED FRAUD BAND
    // =========================================================================

    AddRuleRiskBand =
        Table.AddColumn(
            AddRuleScore,
            "RuleBasedFraudBand",
            each
                if [RuleBasedFraudScore] >= 80
                then "CRITICAL"
                else if [RuleBasedFraudScore] >= 60
                then "HIGH"
                else if [RuleBasedFraudScore] >= 35
                then "MEDIUM"
                else if [RuleBasedFraudScore] >= 15
                then "LOW"
                else "INFO",
            type text
        ),


    // =========================================================================
    // 26. FRAUD ALERT SOURCE
    // =========================================================================

    FraudAlertSource =
        try FraudAlerts
        otherwise #table(
            {
                "AlertId",
                "TransactionId",
                "CompanyId",
                "AlertDate",
                "FraudScore",
                "FraudProbability",
                "RiskLevel",
                "AlertType",
                "Reason",
                "ModelName",
                "ModelVersion",
                "Status",
                "InvestigationStatus"
            },
            {}
        ),


    // =========================================================================
    // 27. STANDARDIZE FRAUD ALERT COLUMNS
    // =========================================================================

    FraudAlertStandardized =
        Table.TransformColumnNames(
            FraudAlertSource,
            each Text.Trim(_)
        ),


    // =========================================================================
    // 28. ENSURE FRAUD ALERT COLUMNS
    // =========================================================================

    FraudAlertRequiredColumns = {
        "AlertId",
        "TransactionId",
        "CompanyId",
        "AlertDate",
        "FraudScore",
        "FraudProbability",
        "RiskLevel",
        "AlertType",
        "Reason",
        "ModelName",
        "ModelVersion",
        "Status",
        "InvestigationStatus"
    },


    EnsureFraudAlertColumns =
        List.Accumulate(
            FraudAlertRequiredColumns,
            FraudAlertStandardized,
            (state, columnName) =>
                if HasColumn(state, columnName)
                then state
                else Table.AddColumn(
                    state,
                    columnName,
                    each null
                )
        ),


    // =========================================================================
    // 29. TYPE FRAUD ALERT DATA
    // =========================================================================

    TypedFraudAlerts =
        Table.TransformColumns(
            EnsureFraudAlertColumns,
            {
                {
                    "AlertId",
                    each SafeText(_),
                    type text
                },
                {
                    "TransactionId",
                    each SafeText(_),
                    type text
                },
                {
                    "CompanyId",
                    each SafeText(_),
                    type text
                },
                {
                    "AlertDate",
                    each SafeDate(_),
                    type date
                },
                {
                    "FraudScore",
                    each Clamp(_, 0, 100),
                    type number
                },
                {
                    "FraudProbability",
                    each Clamp(_, 0, 1),
                    type number
                },
                {
                    "RiskLevel",
                    each if _ = null then null else Text.Upper(Text.Trim(Text.From(_))),
                    type text
                },
                {
                    "AlertType",
                    each if _ = null then null else Text.Upper(Text.Trim(Text.From(_))),
                    type text
                },
                {
                    "Reason",
                    each SafeText(_),
                    type text
                },
                {
                    "ModelName",
                    each SafeText(_),
                    type text
                },
                {
                    "ModelVersion",
                    each SafeText(_),
                    type text
                },
                {
                    "Status",
                    each if _ = null then null else Text.Upper(Text.Trim(Text.From(_))),
                    type text
                },
                {
                    "InvestigationStatus",
                    each if _ = null then null else Text.Upper(Text.Trim(Text.From(_))),
                    type text
                }
            }
        ),


    // =========================================================================
    // 30. JOIN ML FRAUD ALERTS TO TRANSACTIONS
    // =========================================================================

    JoinFraudAlerts =
        Table.NestedJoin(
            AddMissingPartyFlag,
            {
                "TransactionId",
                "CompanyId"
            },
            TypedFraudAlerts,
            {
                "TransactionId",
                "CompanyId"
            },
            "FraudAlertData",
            JoinKind.LeftOuter
        ),


    // =========================================================================
    // 31. EXPAND ML OUTPUT
    // =========================================================================

    ExpandFraudAlerts =
        Table.ExpandTableColumn(
            JoinFraudAlerts,
            "FraudAlertData",
            {
                "AlertId",
                "AlertDate",
                "FraudScore",
                "FraudProbability",
                "RiskLevel",
                "AlertType",
                "Reason",
                "ModelName",
                "ModelVersion",
                "Status",
                "InvestigationStatus"
            },
            {
                "FraudAlertId",
                "FraudAlertDate",
                "FraudScore",
                "FraudProbability",
                "FraudRiskLevel",
                "FraudAlertType",
                "FraudReason",
                "FraudModelName",
                "FraudModelVersion",
                "FraudAlertStatus",
                "FraudInvestigationStatus"
            }
        ),


    // =========================================================================
    // 32. FINAL FRAUD SCORE
    // =========================================================================

    AddFinalFraudScore =
        Table.AddColumn(
            ExpandFraudAlerts,
            "FinalFraudScore",
            each
                let
                    MLScore = SafeNumber([FraudScore]),
                    RuleScore = SafeNumber([RuleBasedFraudScore])
                in
                    if MLScore <> null
                    then
                        Clamp(
                            MLScore * 0.70
                            + RuleScore * 0.30,
                            0,
                            100
                        )
                    else
                        Clamp(
                            RuleScore,
                            0,
                            100
                        ),
            type number
        ),


    // =========================================================================
    // 33. FINAL FRAUD RISK BAND
    // =========================================================================

    AddFinalFraudBand =
        Table.AddColumn(
            AddFinalFraudScore,
            "FinalFraudRiskBand",
            each
                if [FinalFraudScore] >= 80
                then "CRITICAL"
                else if [FinalFraudScore] >= 60
                then "HIGH"
                else if [FinalFraudScore] >= 35
                then "MEDIUM"
                else if [FinalFraudScore] >= 15
                then "LOW"
                else "INFO",
            type text
        ),


    // =========================================================================
    // 34. FRAUD ALERT FLAG
    // =========================================================================

    AddFraudAlertFlag =
        Table.AddColumn(
            AddFinalFraudBand,
            "FraudAlertFlag",
            each
                if [FinalFraudScore] >= 60
                    or [FraudAlertId] <> null
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 35. CRITICAL FRAUD FLAG
    // =========================================================================

    AddCriticalFraudFlag =
        Table.AddColumn(
            AddFraudAlertFlag,
            "CriticalFraudFlag",
            each
                if [FinalFraudScore] >= 80
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 36. HIGH FRAUD FLAG
    // =========================================================================

    AddHighFraudFlag =
        Table.AddColumn(
            AddCriticalFraudFlag,
            "HighFraudFlag",
            each
                if [FinalFraudScore] >= 60
                then 1
                else 0,
            Int64.Type
        ),


    // =========================================================================
    // 37. INVESTIGATION REQUIRED
    // =========================================================================

    AddInvestigationRequired =
        Table.AddColumn(
            AddHighFraudFlag,
            "InvestigationRequired",
            each
                if
                    [FinalFraudScore] >= 60
                    or [FraudInvestigationStatus] = "OPEN"
                    or [FraudInvestigationStatus] = "PENDING"
                then "YES"
                else "NO",
            type text
        ),


    // =========================================================================
    // 38. PRIORITY
    // =========================================================================

    AddInvestigationPriority =
        Table.AddColumn(
            AddInvestigationRequired,
            "InvestigationPriority",
            each
                if [FinalFraudScore] >= 80
                then "P1 — CRITICAL"
                else if [FinalFraudScore] >= 60
                then "P2 — HIGH"
                else if [FinalFraudScore] >= 35
                then "P3 — MEDIUM"
                else "P4 — LOW",
            type text
        ),


    // =========================================================================
    // 39. FRAUD SIGNAL COUNT
    // =========================================================================

    AddFraudSignalCount =
        Table.AddColumn(
            AddInvestigationPriority,
            "FraudSignalCount",
            each
                [DuplicateTransactionFlag]
                + [HighValueTransactionFlag]
                + [VeryHighValueTransactionFlag]
                + [RoundAmountFlag]
                + [WeekendTransactionFlag]
                + [MonthEndTransactionFlag]
                + [YearEndTransactionFlag]
                + [PaymentMethodRiskFlag]
                + [MissingPartyFlag],
            Int64.Type
        ),


    // =========================================================================
    // 40. FRAUD SIGNAL STRENGTH
    // =========================================================================

    AddFraudSignalStrength =
        Table.AddColumn(
            AddFraudSignalCount,
            "FraudSignalStrength",
            each
                if [FraudSignalCount] >= 5
                then "VERY_HIGH"
                else if [FraudSignalCount] >= 3
                then "HIGH"
                else if [FraudSignalCount] >= 2
                then "MEDIUM"
                else if [FraudSignalCount] = 1
                then "LOW"
                else "NONE",
            type text
        ),


    // =========================================================================
    // 41. FRAUD REASON
    // =========================================================================

    AddFraudReason =
        Table.AddColumn(
            AddFraudSignalStrength,
            "DashboardFraudReason",
            each
                if [FraudReason] <> null
                then [FraudReason]
                else if [DuplicateTransactionFlag] = 1
                then "Duplicate transaction pattern"
                else if [VeryHighValueTransactionFlag] = 1
                then "Very high-value transaction"
                else if [HighValueTransactionFlag] = 1
                then "High-value transaction"
                else if [RoundAmountFlag] = 1
                then "Unusual round-value transaction"
                else if [WeekendTransactionFlag] = 1
                then "Weekend transaction"
                else if [MonthEndTransactionFlag] = 1
                then "Month-end transaction"
                else if [PaymentMethodRiskFlag] = 1
                then "Higher-risk payment method"
                else if [MissingPartyFlag] = 1
                then "Missing customer/supplier identifier"
                else "No material fraud signal",
            type text
        ),


    // =========================================================================
    // 42. AI INVESTIGATION SIGNAL
    // =========================================================================

    AddAgentSignal =
        Table.AddColumn(
            AddFraudReason,
            "SupervisorAgentSignal",
            each
                if [FinalFraudScore] >= 80
                then "ESCALATE_TO_SUPERVISOR"
                else if [FinalFraudScore] >= 60
                then "START_FRAUD_INVESTIGATION"
                else if [FinalFraudScore] >= 35
                then "REVIEW_TRANSACTION"
                else "NO_IMMEDIATE_ACTION",
            type text
        ),


    // =========================================================================
    // 43. RAG EVIDENCE TRIGGER
    // =========================================================================

    AddRAGEvidenceTrigger =
        Table.AddColumn(
            AddAgentSignal,
            "RAGEvidenceRequired",
            each
                if [FinalFraudScore] >= 35
                then "YES"
                else "NO",
            type text
        ),


    // =========================================================================
    // 44. FORECAST TRIGGER
    // =========================================================================

    AddForecastTrigger =
        Table.AddColumn(
            AddRAGEvidenceTrigger,
            "FraudForecastRequired",
            each
                if [FinalFraudScore] >= 60
                then "YES"
                else "NO",
            type text
        ),


    // =========================================================================
    // 45. WHAT-IF TRIGGER
    // =========================================================================

    AddWhatIfTrigger =
        Table.AddColumn(
            AddForecastTrigger,
            "WhatIfAnalysisRequired",
            each
                if [FinalFraudScore] >= 80
                then "YES"
                else "NO",
            type text
        ),


    // =========================================================================
    // 46. HUMAN REVIEW
    // =========================================================================

    AddHumanReview =
        Table.AddColumn(
            AddWhatIfTrigger,
            "HumanReviewRequired",
            each
                if [FinalFraudScore] >= 60
                then "YES"
                else "NO",
            type text
        ),


    // =========================================================================
    // 47. FRAUD DECISION
    // =========================================================================

    AddFraudDecision =
        Table.AddColumn(
            AddHumanReview,
            "FraudDecision",
            each
                if [FinalFraudScore] >= 80
                then "BLOCK_AND_ESCALATE"
                else if [FinalFraudScore] >= 60
                then "HOLD_AND_INVESTIGATE"
                else if [FinalFraudScore] >= 35
                then "MONITOR"
                else "NORMAL",
            type text
        ),


    // =========================================================================
    // 48. DATA QUALITY
    // =========================================================================

    AddDataCompleteness =
        Table.AddColumn(
            AddFraudDecision,
            "FraudDataCompleteness",
            each
                let
                    Fields = {
                        [TransactionId],
                        [CompanyId],
                        [TransactionDate],
                        [Amount],
                        [TransactionType],
                        [PaymentMethod]
                    },

                    Available =
                        List.Count(
                            List.Select(
                                Fields,
                                each _ <> null
                            )
                        ),

                    Total =
                        List.Count(Fields)
                in
                    SafeDivide(
                        Available,
                        Total
                    ) * 100,
            type number
        ),


    AddDataQuality =
        Table.AddColumn(
            AddDataCompleteness,
            "FraudDataQuality",
            each
                if [FraudDataCompleteness] >= 95
                then "HIGH"
                else if [FraudDataCompleteness] >= 80
                then "MEDIUM"
                else if [FraudDataCompleteness] >= 60
                then "LOW"
                else "CRITICAL",
            type text
        ),


    // =========================================================================
    // 49. AUDIT STATUS
    // =========================================================================

    AddAuditStatus =
        Table.AddColumn(
            AddDataQuality,
            "FraudAuditStatus",
            each
                if [FraudAlertFlag] = 1
                then "REQUIRES_AUDIT"
                else "NORMAL",
            type text
        ),


    // =========================================================================
    // 50. FINAL STATUS
    // =========================================================================

    AddDashboardStatus =
        Table.AddColumn(
            AddAuditStatus,
            "FraudDashboardStatus",
            each
                if [FinalFraudScore] >= 80
                then "CRITICAL_FRAUD"
                else if [FinalFraudScore] >= 60
                then "HIGH_FRAUD_RISK"
                else if [FinalFraudScore] >= 35
                then "FRAUD_WATCH"
                else "NORMAL",
            type text
        ),


    // =========================================================================
    // 51. SORT BY TRANSACTION DATE
    // =========================================================================

    SortedTransactions =
        Table.Sort(
            AddDashboardStatus,
            {
                {
                    "TransactionDate",
                    Order.Descending
                },
                {
                    "FinalFraudScore",
                    Order.Descending
                }
            }
        ),


    // =========================================================================
    // 52. ROUND SCORE COLUMNS
    // =========================================================================

    RoundedScores =
        Table.TransformColumns(
            SortedTransactions,
            {
                {
                    "RuleBasedFraudScore",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "FinalFraudScore",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "FraudProbability",
                    each
                        if _ = null
                        then null
                        else Number.Round(_, 4),
                    type number
                },
                {
                    "FraudDataCompleteness",
                    each Number.Round(_, 2),
                    type number
                }
            }
        ),


    // =========================================================================
    // 53. FINAL COLUMN ORDER
    // =========================================================================

    PreferredColumns = {
        "FraudTransactionKey",
        "TransactionId",
        "CompanyId",
        "CompanyName",
        "TransactionDate",
        "FraudYear",
        "FraudMonth",
        "FraudMonthName",
        "FraudQuarter",
        "FraudPeriodKey",

        "CustomerId",
        "SupplierId",
        "AccountId",

        "TransactionType",
        "TransactionCategory",
        "TransactionDirection",
        "PaymentMethod",
        "Currency",

        "Amount",
        "AbsoluteAmount",

        "DuplicateTransactionCount",
        "DuplicateTransactionFlag",
        "HighValueTransactionFlag",
        "VeryHighValueTransactionFlag",
        "RoundAmountFlag",
        "WeekendTransactionFlag",
        "MonthEndTransactionFlag",
        "YearEndTransactionFlag",
        "PaymentMethodRiskFlag",
        "MissingPartyFlag",

        "RuleBasedFraudScore",
        "RuleBasedFraudBand",

        "FraudAlertId",
        "FraudAlertDate",
        "FraudScore",
        "FraudProbability",
        "FraudRiskLevel",
        "FraudAlertType",
        "FraudReason",
        "FraudModelName",
        "FraudModelVersion",
        "FraudAlertStatus",
        "FraudInvestigationStatus",

        "FinalFraudScore",
        "FinalFraudRiskBand",

        "FraudAlertFlag",
        "CriticalFraudFlag",
        "HighFraudFlag",

        "FraudSignalCount",
        "FraudSignalStrength",

        "InvestigationRequired",
        "InvestigationPriority",
        "DashboardFraudReason",

        "SupervisorAgentSignal",
        "RAGEvidenceRequired",
        "FraudForecastRequired",
        "WhatIfAnalysisRequired",
        "HumanReviewRequired",

        "FraudDecision",

        "FraudDataCompleteness",
        "FraudDataQuality",
        "FraudAuditStatus",
        "FraudDashboardStatus",

        "Description",
        "Status"
    },


    ExistingPreferredColumns =
        List.Intersect(
            {
                PreferredColumns,
                Table.ColumnNames(RoundedScores)
            }
        ),


    RemainingColumns =
        List.Difference(
            Table.ColumnNames(RoundedScores),
            ExistingPreferredColumns
        ),


    FinalColumnOrder =
        List.Combine(
            {
                ExistingPreferredColumns,
                RemainingColumns
            }
        ),


    Reordered =
        Table.ReorderColumns(
            RoundedScores,
            FinalColumnOrder,
            MissingField.Ignore
        ),


    // =========================================================================
    // 54. FINAL OUTPUT
    // =========================================================================

    Final =
        Reordered

in
    Final